# Copy to deploy/.env.production and fill in real values. Never commit secrets.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/DB_NAME
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://your-apiwatch-domain.example
NEXT_PUBLIC_API_URL=https://api.your-apiwatch-domain.example/api/v1
WEB_PORT=3000
CHECK_CONCURRENCY=20
MIN_INTERVAL_SECONDS=30
SCHEDULER_ENABLED=true
RUN_WORKER=true
RECONCILE_INTERVAL_SECONDS=300
QUEUE_PREFIX=apiwatch
